# API Keys Template
# Copy this file to secrets.yaml and fill in your API keys
# DO NOT COMMIT secrets.yaml

api:
  # Get free key at: https://newsapi.org/register
  newsapi_key: "your-newsapi-key-here"

  # Get key at: https://console.anthropic.com/
  anthropic_key: "your-anthropic-key-here"

# Data collection settings (optional)
collection:
  delay: 1.0
  yahoo_max_per_ticker: 10
  newsapi_days_back: 7
  newsapi_articles_per_company: 20
  edgar_filings_per_company: 10
  sec_user_agent: "YourName contact@example.com"

# Model settings (optional)
model:
  encoder_name: "allenai/longformer-base-4096"
  device: "auto"  # auto, cuda, mps, cpu
